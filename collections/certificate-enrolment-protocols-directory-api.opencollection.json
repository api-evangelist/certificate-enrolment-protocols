{
  "opencollection": "1.0.0",
  "info": {
    "name": "ACME (RFC 8555) Protocol Account Directory API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Directory",
        "type": "folder"
      },
      "items": [
