        {
          "info": {
            "name": "Retrieve a new nonce",
            "type": "http"
          },
          "http": {
            "method": "HEAD",
            "url": "https://acme-v02.api.letsencrypt.org/acme/new-nonce"
          },
          "docs": "Retrieve a fresh anti-replay nonce in the Replay-Nonce header."
        }
      ]
    }
  ],
  "bundled": true
